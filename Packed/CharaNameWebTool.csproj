<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CharaNameWebTool</AssemblyName>
    <RootNamespace>CharaNameWebTool</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\index.html" Link="web\index.html" />
    <EmbeddedResource Include="..\style.css" Link="web\style.css" />
    <EmbeddedResource Include="..\app.js" Link="web\app.js" />
    <EmbeddedResource Include="vendor\*" Link="vendor\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
